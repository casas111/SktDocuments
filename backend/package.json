{
  "name": "simetrik-ai-documents-backend",
  "version": "1.0.0",
  "description": "Backend for Simetrik AI Documents platform",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
