# API Configuration
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_API_KEY=your-api-key-here

# Authentication
REACT_APP_AUTH0_DOMAIN=your-auth0-domain.auth0.com
REACT_APP_AUTH0_CLIENT_ID=your-auth0-client-id
REACT_APP_AUTH0_AUDIENCE=your-auth0-audience

# Application Settings
REACT_APP_APP_NAME=Document Management System
REACT_APP_APP_VERSION=1.0.0
REACT_APP_APP_ENV=development

# File Upload Settings
REACT_APP_MAX_FILE_SIZE=10485760 # 10MB in bytes
REACT_APP_ALLOWED_FILE_TYPES=image/*,application/pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx

# Storage Settings
REACT_APP_STORAGE_TYPE=local # or 's3' for AWS S3
REACT_APP_S3_BUCKET=your-s3-bucket-name
REACT_APP_S3_REGION=your-s3-region

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_LOGGING=true 